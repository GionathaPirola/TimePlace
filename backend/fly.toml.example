# Example Fly.io config for the backend. Generate the real one with `fly launch --no-deploy`
# from inside backend/, then adjust as needed; this file just documents the intended shape.
app = "timeplace-backend"  # TODO: pick a globally unique app name
primary_region = "fra"      # TODO: pick the region closest to your users/DB

[build]

[env]
  SERVER_PORT = "8080"

[http_service]
  internal_port = 8080
  force_https = true
  auto_stop_machines = true
  auto_start_machines = true
  min_machines_running = 0

[[vm]]
  cpu_kind = "shared"
  cpus = 1
  memory_mb = 256

# Set secrets (not committed) with:
#   fly secrets set DB_HOST=... DB_PORT=5432 DB_NAME=... DB_USER=... DB_PASSWORD=... EUROPEANA_API_KEY=...
